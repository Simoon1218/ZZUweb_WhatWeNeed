# 服务监听端口（Render 会自动注入 PORT）
PORT=8000

# 会话 Cookie 签名密钥（Render 通过 render.yaml 自动生成）
SESSION_SECRET=change-me-to-a-random-hex-string

# 登录会话有效期（小时）
SESSION_TTL_HOURS=24

# 请求郑州大学上游接口的超时时间（秒）
REQUEST_TIMEOUT=15

# 可选：代理地址（若海外机房直连 ZZU 受限，可配置 HTTP/HTTPS 代理，例如 http://user:pass@host:port）
UPSTREAM_PROXY=

# 可选：强制 Cookie Secure 标志（auto 会根据 X-Forwarded-Proto 自动判断）
COOKIE_SECURE=auto
